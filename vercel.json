{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.affectosphere.group" }],
      "destination": "https://affectosphere.group/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(webp|png|svg|js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    }
  ]
}
